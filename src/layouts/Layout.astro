---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bharat Web Crafts | Web Development & Software Engineering",
  description = "Bharat Web Crafts | portfolio and web development services by Bharatesh Poojary.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
    /* Offset anchor targets so they land below the sticky navbar. */
    scroll-padding-top: 5rem;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
