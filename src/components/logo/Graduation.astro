  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Education"
>
  <title>Education</title>
  {/* Mortarboard */}
  <path d="M32 12 L58 22 L32 32 L6 22 Z"></path>
  {/* Tassel */}
