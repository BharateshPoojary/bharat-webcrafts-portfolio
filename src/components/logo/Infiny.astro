---
const { class: className = "w-40" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 340 140"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Infiny"
>
  <title>Infiny</title>
  {/* "i" - triangle tittle */}
  <path d="M22 11 L22 47 L45 29 Z"></path>
  {/* "i" - stem: straight left edge, top-right raised, bottom-right curved */}
  <path d="M22 62 L42 58 L42 90 Q42 104 27 104 L22 104 Z"></path>
  {/* wordmark */}
  <text
    x="48"
    y="104"
    font-family="Arial, Helvetica, sans-serif"
    font-weight="900"
    font-size="92"
    letter-spacing="-4">nfiny</text
  >
</svg>
