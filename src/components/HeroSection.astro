        </div>
      </div>

      {/* Floating Metric Card 1 */}
      <div
        class="absolute bottom-34 sm:bottom-1 sm:right-75 z-10 sm:w-48 bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl p-2 sm:p-6 transform rotate-6 shadow-2xl hover:rotate-0 transition-all duration-500"
      >
        <div class="flex items-center gap-1.5 mb-2">
          <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
          <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
          <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
        </div>
