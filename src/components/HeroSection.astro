---
import BgpatternAstroComponent from "./common/Bgpattern.astro";
import Background from "./common/Background.astro";
import Bluebutton from "./common/Bluebutton.astro";
import BlueTextAstroComponent from "./common/Blue-text.astro";
import Slack from "./logo/Slack.astro";
import Amazon from "./logo/Amazon.astro";
import Dropbox from "./logo/Drop-box.astro";
import Loom from "./logo/Loom.astro";
import { ArrowUpRight, CircleCheck, Mail, Send } from "@lucide/astro";
---

<section
  id="home"
  data-nav-theme="dark"
  class="relative min-h-screen w-full overflow-clip bg-[#020617] text-white font-sans selection:bg-blue-500/30"
>
  <BgpatternAstroComponent />
  <Background />
  {/* Hero Content */}
  <div
    class="relative z-10 grid gap-1 px-6 mx-auto w-full max-w-7xl xl:max-w-360 2xl:max-w-[1700px] grid-cols-1 lg:grid-cols-2 lg:px-8 2xl:px-12 lg:py-4 items-center"
  >
    {/* Left Column */}
    <div class="max-w-2xl space-y-8">
      <BlueTextAstroComponent text="AI Solution" />
      
      <h1
        class="text-5xl font-bold leading-[1.1] tracking-tight text-white sm:text-7xl"
      >
        From Idea to Production: <br />Full-Stack AI Engineer Shipping
        Revenue-Driving Software.
      </h1>
      <p class="text-lg text-white leading-relaxed max-w-lg">
        A Full-Stack Engineer who designs, builds, and ships products end-to-end
        - that thousands of people rely on every day.
      </p>
      <!-- 
      <div
        class="flex flex-row items-center gap-3 p-1.5 bg-white rounded-2xl max-w-md shadow-2xl"
      >
        <div class="flex items-center flex-1 w-full gap-3 px-4 py-2">
          <Mail class="w-5 h-5 text-slate-400" />
          <input
            type="email"
            placeholder="Send your email"
            class="w-full bg-transparent text-slate-900 placeholder:text-slate-400 focus:outline-none text-sm"
          />
        </div>
        <div class="md:block hidden">
          <Bluebutton arrow="Right" text="Talk to Sales" />
        </div>
        <div class="md:hidden block">
          <button
            class="flex items-center justify-center gap-2 w-full px-4 py-3 text-sm font-semibold text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors group"
          >
            <Send
              class="w-4 h-4 transition-transform group-hover:translate-x-1"
            />
          </button>
        </div>
      </div> -->

      {/* Partners Section */}
      <!-- <div class="pt-4">
        <p class="text-base font-medium text-slate-200 mb-6">
          Partners in Financial Success
        </p>
        <div
          class="grid grid-cols-2 gap-x-8 gap-y-8 md:flex md:flex-wrap md:items-center md:gap-x-12 text-white opacity-80"
        >
          <Slack />
          <Amazon />
          <Dropbox />
          <Loom />
        </div>
      </div> -->
    </div>

    {/* Right Column - UI Composition */}
    <div class="relative flex flex-col items-center gap-2 sm:gap-0 py-8 w-full">
      {/* Code Snippet Window */}
      <div
        class="w-75 sm:w-105 bg-[#1e293b] rounded-2xl shadow-2xl border border-white/10 overflow-hidden transform -rotate-1 hover:-translate-y-1 transition-transform duration-500 px-2 py-4 z-20 before:absolute before:bottom-0 before:left-0 before:w-72 before:h-22 before:bg-linear-to-tr before:from-slate-200 before:via-slate-50 before:opacity-50 before:blur-[10px]"
      >
        <div
          class="flex items-center gap-1.5 px-4 py-3 border-b border-white/10"
        >
          <div class="w-2.5 h-2.5 rounded-full bg-white"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-white"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-white"></div>
        </div>
        <div
          class="p-3 font-mono sm:text-sm text-[11px] leading-relaxed bg-white border-8 border-white/5 rounded-2xl"
        >
          <div class="flex gap-2">
            <span class="text-emerald-400">GET</span>
            <span class="text-black">/api/projects</span>
          </div>
          <div class="mt-2 text-slate-300">
            <span class="text-black">Host:</span>
            <span class="text-emerald-400"> api.bharatwebcrafts.dev</span>
          </div>
          <div class="mt-2 text-slate-300">
            <span class="text-black">Authorization: Bearer{" "}</span>
            <span class="text-orange-400">YOUR_API_KEY</span>
          </div>
          <div class="mt-2 text-slate-300">
            <span class="text-black">Content-Type:application/</span>
            <span class="text-sky-400">json</span>
          </div>
        </div>
      </div>

      {/* Transfer Detail Card */}
      <div
        class="w-[320px] sm:w-135 bg-white rounded-3xl shadow-3xl p-3 sm:p-8 transform rotate-[4deg] hover:rotate-0 transition-all duration-500 z-10"
      >
        <div class="flex justify-between items-start mb-6">
          <div class="space-y-1">
            <div
              class="flex items-center gap-2 text-slate-400 text-xs sm:text-sm"
            >
              <ArrowUpRight class="w-4 h-4" />
              Deploy to Production
            </div>
            <div class="font-semibold text-slate-900">DEPLOY-9823745</div>
            <div class="text-xs text-slate-400 font-medium">
              CI/CD Pipeline
            </div>
          </div>
          <div class="text-right">
            <div
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-emerald-700 bg-emerald-100 text-emerald-700 text-[10px] font-bold uppercase tracking-wider"
            >
              <div
                class="w-3 h-3 rounded-full bg-emerald-500 z-10 flex items-center justify-center"
              >
                <CircleCheck class="w-4 h-4 text-white" />
              </div>
              Success
            </div>
            <div class="mt-2 text-xs text-slate-400">March 12, 2025</div>
            <div class="text-[10px] text-slate-400">14:32 UTC</div>
          </div>
        </div>

        <div
          class="relative flex items-center justify-between mb-4 sm:mb-8 px-2"
        >
          <div
            class="w-3 h-3 rounded-full bg-slate-900 z-10 shadow-lg shadow-black/20"
          >
          </div>
          <div class="absolute left-4 w-1/2 h-0.5 bg-slate-100"></div>
          <div class="absolute left-4 w-1/2 h-0.5 bg-emerald-500"></div>
          <div
            class="w-3 h-3 rounded-full bg-emerald-500 z-10 absolute right-32 sm:right-52 flex items-center justify-center"
          >
            <CircleCheck class="w-4 h-4 text-white" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-1">
          <div class="space-y-2">
            <div
              class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"
            >
              Commit
            </div>
            <div>
              <div
                class="text-md text-[12px] sm:text-2xl font-bold text-slate-900"
              >
                v2.4.1
                <!-- <CurrencyBadge
                                            code="USD"
                                            flag={
                                                <svg viewBox="0 0 24 24" class="w-4 h-4 rounded-full overflow-hidden shadow-sm">
                                                    <rect width="24" height="24" fill="#fff" />
                                                    <path fill="#002868" d="M0 0h12v12H0z" />
                                                    <path
                                                        fill="#bf0a30"
                                                        d="M0 0h24v1.846H0zm0 3.692h24v1.846H0zm0 3.693h24v1.846H0zm0 3.692h24v1.846H0zm0 3.692h24v1.846H0zm0 3.692h24v1.847H0zm0 3.692h24V24H0z"
                                                    />
                                                    <path
                                                        fill="#fff"
                                                        d="M1.333 1.333l.48 1.474.48-1.474H1.333zm2.667 0l.48 1.474.48-1.474H4zm2.667 0l.48 1.474.48-1.474H6.667zm2.666 0l.48 1.474.48-1.474H9.333z"
                                                    />
                                                </svg>
                                            }
                                        /> -->
              </div>
              <div class="text-xs font-semibold text-slate-900 mt-1">
                Bharatesh Poojary
              </div>
              <div class="text-[7px] sm:text-[10px] text-slate-400">
                github.com/BharateshPoojary • a1b2c3d
              </div>
            </div>
          </div>
          <div class="space-y-2">
            <div
              class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"
            >
              Environment
            </div>
            <div>
              <div class="text-[12px] sm:text-2xl font-bold text-slate-900">
                Production
                <!-- <CurrencyBadge
                                            code="JPY"
                                            flag={
                                                <svg
                                                    viewBox="0 0 24 24"
                                                    class="w-4 h-4 rounded-full overflow-hidden border border-slate-100 shadow-sm"
                                                >
                                                    <rect width="24" height="24" fill="#fff" />
                                                    <circle cx="12" cy="12" r="7" fill="#bc002d" />
                                                </svg>
                                            }
                                        /> -->
              </div>
              <div class="text-xs font-semibold text-slate-900 mt-1">
                Hostinger · Mumbai, IN
              </div>
              <div class="text-[7px] sm:text-[10px] text-slate-400">
                srv1466521.hstgr.cloud • Ubuntu 25.10
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Floating Metric Cards Row */}
      <div
        class="flex items-center justify-center gap-4 sm:gap-4 -mt-2 sm:-mt-4 z-20"
      >
        {/* Floating Metric Card 1 */}
        <div
          class="w-40 sm:w-48 bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl p-2 sm:p-6 transform rotate-6 shadow-2xl hover:rotate-0 transition-all duration-500"
        >
          <div class="flex items-center gap-1.5 mb-2">
            <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
          </div>
          <div class="bg-white rounded-xl p-2 sm:p-4 shadow-inner">
            <div class="text-4xl font-bold text-slate-900">4k+</div>
            <div class="text-xs font-medium text-slate-400 mt-1">
              Users Reached across platforms
            </div>
          </div>
        </div>

        {/* Floating Metric Card 2 */}
        <div
          class="w-40 sm:w-48 backdrop-blur-xl rounded-2xl p-2 sm:p-6 shadow-blue-500/20 shadow-2xl transform -rotate-6 hover:rotate-0 transition-all duration-500"
        >
          <div class="flex items-center gap-1.5 mb-2">
            <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
          </div>
          <div
            class="bg-white rounded-xl p-4 border border-blue-100 shadow-inner"
          >
            <div class="text-4xl font-bold text-slate-900">7+</div>
            <div class="text-xs font-medium text-slate-400 mt-1">
              Full-stack products shipped
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
