---
import BgpatternAstroComponent from "./common/Bgpattern.astro";
import Background from "./common/Background.astro";
import Bluebutton from "./common/Bluebutton.astro";
import BlueTextAstroComponent from "./common/Blue-text.astro";
import Slack from "./logo/Slack.astro";
import Amazon from "./logo/Amazon.astro";
import Dropbox from "./logo/Drop-box.astro";
import Loom from "./logo/Loom.astro";
import { ArrowUpRight, CircleCheck, Mail, Menu, Send, X } from "@lucide/astro";
---

<section
  class="relative min-h-screen w-full overflow-hidden bg-[#020617] text-white font-sans selection:bg-blue-500/30"
>
  <BgpatternAstroComponent />
  <Background />
  {/* Navigation */}
  <header
    class="relative z-50 flex items-center justify-between px-6 py-6 mx-auto w-full max-w-7xl xl:max-w-360 2xl:max-w-[1700px] lg:px-8 2xl:px-12"
  >
    <div class="flex items-center gap-3">
      <div class="relative flex items-center justify-center w-8 h-8">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 500 500"
          width="500"
          height="500"
          role="img"
          aria-label="Bharat Web Crafts"
        >
          <title>Bharat Web Crafts</title>
          <defs>
            <path id="arcText" fill="none" d="M 342 77 A 196 196 0 0 1 342 423"
            ></path>
          </defs>
          <g
            fill="none"
            stroke="#1E90FF"
            stroke-width="11"
            stroke-linecap="round"
          >
            <path d="M 312.9 94.2 A 168 168 0 1 0 312.9 405.8"></path>
          </g>
          <text
            x="246"
            y="352"
            fill="#1E90FF"
            font-family="Georgia, 'Times New Roman', 'Playfair Display', serif"
            font-size="300"
            font-weight="700"
            text-anchor="middle">B</text
          >
          <text
            fill="#1E90FF"
            font-family="Helvetica, Arial, sans-serif"
            font-size="26"
            font-weight="700"
            letter-spacing="7"
          >
            <textPath href="#arcText" xlink:href="#arcText" startOffset="4%"
              >BHARAT WEB CRAFTS</textPath
            >
          </text>
        </svg>
      </div>
      <span class="text-xl font-bold tracking-tight">Bharat Web Crafts</span>
    </div>

    {/* Desktop Navigation */}
    <nav
      class="hidden md:flex items-center gap-8 text-md font-medium text-slate-100"
    >
      <a href="#" class="hover:text-white transition-colors"> Home </a>
      <a href="#" class="hover:text-white transition-colors"> About </a>
      <a href="#" class="hover:text-white transition-colors"> Timeline </a>
      <a href="#" class="hover:text-white transition-colors"> Projects </a>
      <!-- <a href="#" class="hover:text-white transition-colors"> Contact </a> -->
    </nav>

    <div class="hidden md:flex items-center gap-4">
      <!-- <button
        class="text-sm font-medium hover:text-blue-400 cursor-pointer transition-colors"
        >Login</button
      > -->
      <Bluebutton arrow="UpRight" text="Contact" />
    </div>

    <button
      id="mobile-menu-open"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="md:hidden p-2 text-slate-300 hover:text-white transition-colors"
    >
      <Menu class="w-6 h-6" />
    </button>
  </header>

  {/* Mobile Sidebar Navigation */}
  <div
    id="mobile-menu"
    class="fixed inset-0 z-60 bg-[#020617]/95 backdrop-blur-xl transition-transform duration-300 md:hidden translate-x-full"
  >
    <button
      id="mobile-menu-close"
      aria-label="Close menu"
      class="absolute top-6 right-6 p-2 text-slate-300 hover:text-white transition-colors"
    >
      <X class="w-6 h-6" />
    </button>
    <div
      class="flex flex-col items-center justify-center h-full gap-8 text-xl font-medium"
    >
      <a href="#" class="mobile-menu-link"> Home </a>
      <a href="#" class="mobile-menu-link"> About </a>
      <a href="#" class="mobile-menu-link"> Timeline </a>
      <a href="#" class="mobile-menu-link"> Projects </a>
      <div class="flex flex-col gap-4 w-full px-12 mt-4 items-center">
        <Bluebutton arrow="UpRight" text="Contact" />
      </div>
    </div>
  </div>

  {/* Hero Content */}
  <div
    class="relative z-10 grid gap-1 px-6 mx-auto w-full max-w-7xl xl:max-w-360 2xl:max-w-[1700px] grid-cols-1 lg:grid-cols-2 lg:px-8 2xl:px-12 lg:py-4 items-center"
  >
    {/* Left Column */}
    <div class="max-w-2xl space-y-8">
