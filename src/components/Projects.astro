---
import Heading from "./common/Heading.astro";
import BgpatternAstroComponent from "./common/Bgpattern.astro";
import Background from "./common/Background.astro";
import ProjectShowcase from "./ProjectShowcase.astro";
---

<section
  id="projects"
  data-nav-theme="dark"
  class="relative flex min-h-screen w-full flex-col justify-center overflow-clip bg-[#020617] text-white font-sans py-20 sm:py-28"
>
  <BgpatternAstroComponent />
  <Background />

  <div
    class="relative z-10 mx-auto w-full max-w-7xl xl:max-w-360 px-6 lg:px-8"
  >
    <Heading
      text="My Work"
      heading="Projects I've Built"
      description="A selection of products I've designed, built, and shipped end-to-end."
      type="dark"
    />

    <ProjectShowcase />
  </div>
</section>
