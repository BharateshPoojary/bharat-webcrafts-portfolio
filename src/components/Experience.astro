---
import Heading from "./common/Heading.astro";
import TimelineItem from "./common/TimelineItem.astro";
import TimelineLogo from "./common/TimelineLogo.astro";
import timeline from "../data/timeline.json";
---

<section
  id="timeline"
  data-nav-theme="light"
  class="relative w-full bg-white py-20 sm:py-28 text-slate-900 font-sans"
>
  {/* Subtle dot grid behind the section */}
  <div
    class="absolute inset-0 z-0 opacity-[0.35] pointer-events-none"
    style={{
      backgroundImage: `radial-gradient(#cbd5e1 1.5px, transparent 1.5px)`,
      backgroundSize: "28px 28px",
    }}
  >
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl xl:max-w-360 px-6 lg:px-8">
    <Heading
      text="Experience & Education"
      heading="My Journey So Far"
      description="The roles and education that shaped how I build."
      type="light"
    />

    {/* Experience Timeline */}
    <div class="mt-16 lg:grid lg:grid-cols-2 lg:gap-12">
      {/* Left: the timeline */}
      <div class="relative max-w-2xl">
        {/* Continuous track line behind every entry */}
        <span
          class="pointer-events-none absolute left-0 top-0 bottom-0 w-px bg-slate-200"
        ></span>

        {timeline.map((item, i) => <TimelineItem item={item} index={i} />)}
      </div>

      {/* Right: sticky stage showing the active entry's logo */}
      <div class="hidden lg:block">
        <div class="sticky top-32 flex h-[70vh] items-center justify-center">
          {
            timeline.map((item, i) =>
              item.logo ? (
                <div
                  class="stage-logo absolute text-slate-900"
                  data-stage-index={i}
                >
                  <TimelineLogo name={item.logo} class="w-80 xl:w-96" />
                </div>
              ) : null,
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Highlight the timeline entry crossing the 60% line of the viewport,
  // and reveal its logo on the right-hand stage.
  const items = Array.from(
    document.querySelectorAll<HTMLElement>("[data-timeline-item]"),
  );
  const stageLogos = Array.from(
    document.querySelectorAll<HTMLElement>(".stage-logo"),
  );

  if (items.length) {
    const setActive = () => {
      const lineY = window.innerHeight * 0.6;
      // The active entry is the last one whose top has passed the line.
      let activeIndex = 0;
      items.forEach((item, i) => {
        if (item.getBoundingClientRect().top <= lineY) activeIndex = i;
      });
      items.forEach((item, i) =>
        item.classList.toggle("is-active", i === activeIndex),
      );
      stageLogos.forEach((logo) =>
        logo.classList.toggle(
          "is-active",
          Number(logo.dataset.stageIndex) === activeIndex,
        ),
      );
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        setActive();
        ticking = false;
      });
    };

    setActive();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }
</script>

<style>
  /* Right-stage logos fade/scale in only while their entry is in view. */
  .stage-logo {
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }
  .stage-logo.is-active {
    opacity: 1;
    transform: scale(1);
  }
</style>
