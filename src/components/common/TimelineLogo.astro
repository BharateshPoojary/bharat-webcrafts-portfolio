---
import Infiny from "../logo/Infiny.astro";
import Vighnotech from "../logo/Vighnotech.astro";
import Lazytech from "../logo/Lazytech.astro";
import Graduation from "../logo/Graduation.astro";

// Map the JSON `logo` string → its logo component.
// Add new company logos here as you create them under logo/.
const logos = {
  Infiny,
  Vighnotech,
  Lazytech,
  Graduation,
};

interface Props {
  name?: string;
  class?: string;
}

const { name, class: className } = Astro.props as Props;
const Logo = name && name in logos ? logos[name as keyof typeof logos] : null;
---

{Logo && <Logo class={className} />}
