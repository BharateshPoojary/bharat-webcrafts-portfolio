---
import {
  ArrowUpRight,
  Bot,
  CalendarCheck,
  CodeXml,
  LayoutDashboard,
  ShoppingCart,
  Smartphone,
} from "@lucide/astro";

// Map JSON icon names to Lucide components so project data stays serialisable.
const icons = {
  Bot,
  CalendarCheck,
  CodeXml,
  LayoutDashboard,
  ShoppingCart,
  Smartphone,
};

const { project } = Astro.props;
const Icon = icons[project.icon as keyof typeof icons] ?? CodeXml;
---

<a
  href={project.link ?? "#"}
  class="group flex flex-col p-6 rounded-2xl bg-neutral-900 border border-neutral-800/50 hover:border-blue-500/30 transition-all duration-300"
>
  <div
    class="relative aspect-square w-full bg-neutral-800 rounded-xl mb-6 flex items-center justify-center group-hover:bg-neutral-700/50 transition-colors"
  >
    <Icon class="w-10 h-10 text-white stroke-[1.5]" />
    <ArrowUpRight
      class="absolute top-4 right-4 w-5 h-5 text-neutral-600 transition-colors group-hover:text-blue-400"
    />
  </div>

  <h3 class="text-lg font-semibold mb-2">{project.title}</h3>
  <p class="text-neutral-500 text-sm leading-relaxed mb-6">
    {project.description}
  </p>

  <div class="mt-auto flex flex-wrap gap-2">
    {
      project.tags.map((tag: string) => (
        <span class="rounded-full border border-neutral-800 px-3 py-1 text-xs font-medium text-neutral-400">
          {tag}
        </span>
      ))
    }
  </div>
</a>
